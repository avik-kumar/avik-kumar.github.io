---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RobotArm from '../components/RobotArm.astro';
import { site } from '../site.config';
import { withBase } from '../lib/url';

const now = [
  { role: 'Robotics & RL Research Assistant', org: 'Ha Lab, Georgia Tech', since: 'Since Jan 2026' },
  { role: 'SMT Solver Research Assistant', org: 'ML for Logic @ Georgia Tech', since: 'Since Nov 2025' },
  { role: 'Data Subteam Lead', org: 'Georgia Tech Solar Racing', since: 'Member since Aug 2025' },
  { role: 'B.S. Computer Science', org: 'Intelligence · Modeling & Simulation', since: 'Expected May 2028' },
];
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__text">
      <p class="meta">Computer Science · Georgia Tech</p>
      <h1 id="hero-title" class="hero__title">
        Building intelligent systems, from algorithms to <em>implementation</em>.
      </h1>
      <p class="hero__lede">
        I'm Avik Kumar, a Computer Science student at Georgia Tech. I build teleoperation and data-collection
        infrastructure for humanoid robot learning at Ha Lab, research learning-guided strategy search for the Z3 SMT
        solver, and lead the data and software team at Georgia Tech Solar Racing.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href={withBase(site.resume)} target="_blank" rel="noopener" data-reach>
          Résumé ↗<span class="visually-hidden"> (PDF, opens in a new tab)</span>
        </a>
        <SocialLinks variant="text" />
      </div>
    </div>

    <div class="hero__figure">
      <RobotArm />
    </div>
  </section>

  <section class="container now" aria-labelledby="now-title">
    <SectionHeading n="01" title="Now" id="now-title" />
    <ul class="now__list">
      {
        now.map((item) => (
          <li class="now__item">
            <span class="now__role">{item.role}</span>
            <span class="now__org">{item.org}</span>
            <span class="now__since meta">{item.since}</span>
          </li>
        ))
      }
    </ul>
    <p class="now__location meta">Based in {site.location}</p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-8);
  }

  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-8);
      padding-block: var(--space-8) var(--space-9);
    }
  }

  .hero__title {
    margin-top: var(--space-4);
    font-size: var(--text-3xl);
  }

  .hero__lede {
    margin-top: var(--space-5);
    max-width: var(--width-prose);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-6);
  }

  .hero__figure {
    max-width: 30rem;
  }

  @media (max-width: 55.99rem) {
    .hero__figure {
      max-width: none;
      padding-top: var(--space-5);
      border-top: 1px solid var(--color-border);
    }
  }

  .now__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .now__item {
    display: grid;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 48rem) {
    .now__item {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) 11rem;
      align-items: baseline;
    }
  }

  .now__role {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .now__org {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .now__since {
      text-align: right;
    }
  }

  .now__location {
    margin-top: var(--space-4);
  }
</style>
