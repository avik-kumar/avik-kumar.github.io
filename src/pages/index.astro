---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import { withBase } from '../lib/url';

const roles = [
  { title: 'Robotics & RL Research Assistant', org: 'Ha Lab, Georgia Tech' },
  { title: 'SMT Solver Research Assistant', org: 'ML for Logic @ Georgia Tech' },
  { title: 'Data Subteam Lead', org: 'Georgia Tech Solar Racing' },
];
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__main">
      <p class="meta">Computer Science · Georgia Tech</p>
      <h1 id="hero-title" class="hero__title">Building intelligent systems, from algorithms to implementation.</h1>
      <p class="hero__lede">
        I'm Avik Kumar, a Computer Science student at Georgia Tech. I build teleoperation and data-collection
        infrastructure for humanoid robot learning at Ha Lab, research learning-guided strategy search for the Z3 SMT
        solver, and lead the data and software team at Georgia Tech Solar Racing.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href={withBase(site.resume)} target="_blank" rel="noopener">
          Résumé
          <Icon name="arrow-up-right" size={14} />
          <span class="visually-hidden">(PDF, opens in a new tab)</span>
        </a>
        <SocialLinks variant="text" />
      </div>
    </div>

    <aside class="hero__aside" aria-label="At a glance">
      <dl class="facts">
        <div>
          <dt class="meta">Currently</dt>
          <dd>
            <ul class="facts__roles">
              {
                roles.map((role) => (
                  <li>
                    {role.title}
                    <span>{role.org}</span>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
        <div>
          <dt class="meta">Studying</dt>
          <dd>
            B.S. Computer Science
            <span>Intelligence · Modeling &amp; Simulation</span>
          </dd>
        </div>
        <div>
          <dt class="meta">Graduating</dt>
          <dd>May 2028</dd>
        </div>
        <div>
          <dt class="meta">Based in</dt>
          <dd>{site.location}</dd>
        </div>
      </dl>
    </aside>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--space-8) var(--space-7);
  }

  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--space-8);
      padding-block: var(--space-9) var(--space-8);
    }
  }

  .hero__main {
    max-width: 44rem;
  }

  .hero__title {
    margin-top: var(--space-4);
    font-size: var(--text-3xl);
  }

  .hero__lede {
    margin-top: var(--space-5);
    max-width: var(--width-prose);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-6);
  }

  .hero__aside {
    align-self: end;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 56rem) {
    .hero__aside {
      padding-top: 0;
      padding-left: var(--space-5);
      border-top: 0;
      border-left: 1px solid var(--color-border);
    }
  }

  .facts {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .facts dd {
    margin: var(--space-2) 0 0;
  }

  .facts dd span {
    display: block;
    color: var(--color-text-muted);
  }

  .facts__roles {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
