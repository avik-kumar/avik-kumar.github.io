---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RobotArm from '../components/RobotArm.astro';
import { PROJECT_CATEGORIES } from '../lib/taxonomy';
import { getProjects } from '../lib/projects';
import { withBase } from '../lib/url';

const now = [
  {
    href: '/work/ha-lab/',
    text: 'Teleoperation and data collection for flow-matching policies on a Unitree G1',
  },
  {
    href: '/work/z3-alpha2/',
    text: 'Learning-guided strategy search for Z3-alpha2',
  },
  {
    href: '/work/solar-racing/',
    text: 'Telemetry, simulation, and race software for Georgia Tech Solar Racing',
  },
];

const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
---

<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__text">
      <p class="meta">Computer Science · Georgia Tech</p>
      <h1 id="hero-title" class="hero__title">
        Building intelligent systems, from algorithms to <em>implementation</em>.
      </h1>
      <p class="hero__lede">
        I'm Avik Kumar, a Computer Science student at Georgia Tech. I build teleoperation and data-collection
        infrastructure for humanoid robot learning at Ha Lab, research learning-guided strategy search for the Z3 SMT
        solver, and lead the data and software team at Georgia Tech Solar Racing.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href={withBase('/work/')} data-reach>View work</a>
      </div>
    </div>

    <div class="hero__figure">
      <RobotArm />
    </div>
  </section>

  <section class="container now" aria-labelledby="now-title">
    <SectionHeading n="01" title="Now" id="now-title" />
    <ul class="now__list">
      {
        now.map((item) => (
          <li class="now__item">
            <a class="now__link" href={withBase(item.href)}>
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    featured.length > 0 && (
      <section class="container selected" aria-labelledby="selected-title">
        <SectionHeading n="02" title="Selected work" id="selected-title" />
        <ul class="selected__list">
          {featured.map((project) => (
            <li class="selected__item">
              <a class="selected__link" href={withBase(`/work/${project.id}/`)}>
                <span class="meta meta--accent">{PROJECT_CATEGORIES[project.data.categories[0]]}</span>
                <span class="selected__title">{project.data.title}</span>
                <span class="selected__summary">{project.data.summary}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="selected__more">
          <a class="link-underline" href={withBase('/work/')}>
            All work
          </a>
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7) var(--space-8);
  }

  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-8);
      padding-block: var(--space-8) var(--space-9);
    }
  }

  .hero__title {
    margin-top: var(--space-4);
    font-size: var(--text-3xl);
  }

  .hero__lede {
    margin-top: var(--space-5);
    max-width: var(--width-prose);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-6);
  }

  .hero__figure {
    max-width: 30rem;
  }

  @media (max-width: 55.99rem) {
    .hero__figure {
      max-width: none;
      padding-top: var(--space-5);
      border-top: 1px solid var(--color-border);
    }
  }

  .now__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .now__item {
    border-bottom: 1px solid var(--color-border);
  }

  .now__link {
    display: block;
    padding-block: var(--space-4);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.35;
    color: var(--color-text);
    text-decoration: none;
  }

  .now__link:hover {
    color: var(--color-accent);
  }

  .selected {
    padding-block: var(--space-8) var(--space-9);
  }

  .selected__list {
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .selected__item {
    border-bottom: 1px solid var(--color-border);
  }

  .selected__item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .selected__link {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-5);
    text-decoration: none;
    color: inherit;
  }

  .selected__link:hover .selected__title {
    color: var(--color-accent);
  }

  .selected__title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: var(--leading-snug);
    transition: color var(--duration) var(--ease);
  }

  .selected__summary {
    max-width: var(--width-prose);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .selected__more {
    margin-top: var(--space-5);
  }
</style>
