---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECT_CATEGORIES } from '../../lib/taxonomy';
import { formatDateRange, getProjects } from '../../lib/projects';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, role, organization, startDate, endDate, categories, technologies, links, wip } = project.data;
const primary = categories[0];
---

<BaseLayout title={title} description={summary}>
  <article class="container page">
    <p class="meta">
      <a class="page__back" href={withBase('/work/')}>Work</a>
    </p>

    <header class="project-header">
      <p class="project-header__kicker">
        <span class="meta meta--accent">{PROJECT_CATEGORIES[primary]}</span>
        {wip && <span class="meta">In progress</span>}
      </p>
      <h1 class="project-header__title">{title}</h1>
      <p class="project-header__summary">{summary}</p>
      <p class="project-header__role">{[role, organization].filter(Boolean).join(', ')}</p>
      <p class="meta">{formatDateRange(startDate, endDate)}</p>
      {
        technologies.length > 0 && (
          <ul class="pills project-header__pills">
            {technologies.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        )
      }
      {
        links.length > 0 && (
          <ul class="project-header__links">
            {links.map((link) => (
              <li>
                <a class="link-underline" href={link.href} target="_blank" rel="noopener">
                  {link.label} ↗
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose project-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-7) var(--space-9);
  }

  .page__back {
    color: inherit;
    text-decoration: none;
  }

  .page__back:hover {
    color: var(--color-accent);
  }

  .project-header {
    margin-top: var(--space-4);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-text);
  }

  .project-header__kicker {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .project-header__title {
    font-size: 2rem;
  }

  .project-header__summary {
    margin-top: var(--space-4);
    max-width: var(--width-prose);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .project-header__role {
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-size: 1.125rem;
  }

  .project-header .meta {
    margin-top: var(--space-2);
  }

  .project-header__pills {
    margin-top: var(--space-4);
  }

  .project-header__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .project-body {
    margin-top: var(--space-7);
    max-width: var(--width-prose);
  }
</style>
