---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../site.config';
import aboutPhoto from '../../assets/about.jpg';
---

<BaseLayout title="About" description={`About ${site.name}, a Computer Science student at Georgia Tech.`}>
  <section class="container page" aria-labelledby="about-title">
    <SectionHeading n="01" title="About" id="about-title" />

    <div class="about">
      <div class="about__copy">
        <p class="about__lede">
          Hello! I'm Avik, a second-year Computer Science student at Georgia Tech. I like working across real-time
          data, robotics, and interactive visualization, usually while wandering into some new idea or field.
        </p>
        <p>
          At Ha Lab I build teleoperation and data-collection tools for flow-matching policies on a Unitree G1. With ML
          for Logic I work on Z3-alpha2, learning-guided strategy search on top of Z3, which we entered in SMT-COMP
          2026. On Georgia Tech Solar Racing I lead the data subteam: telemetry, vehicle simulation, and race-day
          software.
        </p>
        <p>In my free time I watch a lot of movies and practice cardistry.</p>
      </div>

      <figure class="about__figure figure">
        <Image
          src={aboutPhoto}
          alt={`${site.name}, formal portrait`}
          widths={[320, 480, 640]}
          sizes="(min-width: 48rem) 22rem, 100vw"
          class="about__photo"
        />
        <figcaption class="about__edu">
          B.S. Computer Science, Intelligence and Modeling & Simulation, expected May 2028, GPA 4.00
        </figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-7) var(--space-9);
  }

  .about {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-5);
  }

  @media (min-width: 48rem) {
    .about {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
      align-items: start;
      gap: var(--space-8);
    }
  }

  .about__copy {
    max-width: var(--width-prose);
  }

  .about__lede {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .about__copy p + p {
    margin-top: var(--space-4);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .about__figure {
    margin: 0;
    max-width: 22rem;
  }

  .about__photo {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--color-border-strong);
  }

  .about__edu {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
