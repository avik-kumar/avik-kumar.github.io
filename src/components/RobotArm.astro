---
import {
  ARM,
  BOX_HALF,
  BOX_REST,
  BOX_SIZE,
  GROUND_Y,
  JAW_OPEN,
  REACH,
  REST_TARGET,
  VIEW,
  armFrame,
  jawTransform,
  restPose,
} from '../lib/robot-arm';

interface Props {
  figure?: string;
}

const { figure = '0' } = Astro.props;
const f = armFrame(restPose());
const { base, l1, l2, l3 } = ARM;
const hatches = Array.from({ length: 23 }, (_, i) => 70 + i * 10);
---

<figure class="figure arm" data-robot-arm>
  <svg
    class="arm__svg"
    viewBox={`${VIEW.x} ${VIEW.y} ${VIEW.width} ${VIEW.height}`}
    style={`aspect-ratio: ${VIEW.width} / ${VIEW.height}`}
    role="img"
    aria-label="Line drawing of a three-joint robot arm on a pedestal with a movable box, annotated with its joint angles."
  >
    <g class="arm__construction">
      <path d={`M${base.x - REACH} ${base.y} A${REACH} ${REACH} 0 0 1 ${base.x + REACH} ${base.y}`} class="arm__envelope" />
      <path d={`M60 ${GROUND_Y} H300`} class="arm__ground" />
      <path d={hatches.map((x) => `M${x} ${GROUND_Y} l-8 8`).join(' ')} class="arm__hatch" />
      <path d={`M164 ${GROUND_Y} L170 ${base.y} H190 L196 ${GROUND_Y} Z`} class="arm__pedestal" />
    </g>

    <rect
      class="arm__box"
      data-box
      x={BOX_REST.x - BOX_HALF}
      y={BOX_REST.y - BOX_HALF}
      width={BOX_SIZE}
      height={BOX_SIZE}
      rx="1.5"
    />

    <g class="arm__annotations">
      <path d={`M${base.x} ${base.y} H${base.x + 40}`} class="arm__reference" />
      <path d={f.arc1} class="arm__arc" data-arc="1" />
      <path d={f.arc2} class="arm__arc" data-arc="2" />
      <text x={f.label1.x} y={f.label1.y} class="arm__label" data-label="1">θ₁</text>
      <text x={f.label2.x} y={f.label2.y} class="arm__label" data-label="2">θ₂</text>
    </g>

    <g class="arm__crosshair" data-crosshair transform={`translate(${REST_TARGET.x} ${REST_TARGET.y})`} visibility="hidden">
      <circle r="4.5" />
      <path d="M-11 0 H-6 M6 0 H11 M0 -11 V-6 M0 6 V11" />
    </g>

    <g class="arm__body">
      <g data-link="1" transform={f.link1}>
        <rect x="-9" y="-9" width={l1 + 18} height="18" rx="9" class="arm__link" />
        <path d={`M0 0 H${l1}`} class="arm__centerline" />
        <path d={`M${l1} 0 H${l1 + 30}`} class="arm__reference" />
        <g data-link="2" transform={f.link2}>
          <rect x="-7" y="-7" width={l2 + 14} height="14" rx="7" class="arm__link" />
          <path d={`M0 0 H${l2}`} class="arm__centerline" />
          <g data-link="3" transform={f.link3}>
            <rect x="-5" y="-5" width={l3 + 10} height="10" rx="5" class="arm__link" />
            <path d={`M0 0 H${l3}`} class="arm__centerline" />
            <g transform={`translate(${l3} 0)`} class="arm__gripper">
              <rect x="-2" y="-10" width="4" height="20" rx="1" class="arm__palm" />
              <g data-jaw="upper" transform={jawTransform(JAW_OPEN, -1)}>
                <path d="M2 -2 H14 L18 1.5" />
              </g>
              <g data-jaw="lower" transform={jawTransform(JAW_OPEN, 1)}>
                <path d="M2 2 H14 L18 -1.5" />
              </g>
            </g>
            <circle r="4" class="arm__joint" />
            <circle r="1.4" class="arm__pin" />
          </g>
          <circle r="5" class="arm__joint" />
          <circle r="1.6" class="arm__pin" />
        </g>
        <circle r="5.5" class="arm__joint" />
        <circle r="1.8" class="arm__pin" />
      </g>
    </g>
  </svg>

  <figcaption class="figure__caption">
    Fig. {figure} — IK arm solver.
    <span class="arm__readout" aria-hidden="true" data-readout>{f.readout}</span>
  </figcaption>
</figure>

<style>
  .arm__svg {
    width: 100%;
    height: auto;
    overflow: visible;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  @media (max-width: 55.99rem) {
    .arm__svg {
      max-height: 15rem;
    }
  }

  .arm__envelope {
    fill: none;
    stroke: var(--color-line-faint);
    stroke-width: 1;
    stroke-dasharray: 2 5;
  }

  .arm__ground {
    stroke: var(--color-text);
    stroke-width: 1.25;
  }

  .arm__hatch {
    stroke: var(--color-line-faint);
    stroke-width: 1;
  }

  .arm__pedestal {
    fill: var(--color-bg);
    stroke: var(--color-text);
    stroke-width: 1.25;
  }

  .arm__box {
    fill: var(--color-surface);
    stroke: var(--color-text);
    stroke-width: 1.25;
  }

  .arm__reference {
    stroke: var(--color-line-faint);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .arm__arc {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
  }

  .arm__label {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-accent);
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .arm__crosshair {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.25;
  }

  .arm__link {
    fill: var(--color-bg);
    stroke: var(--color-text);
    stroke-width: 1.25;
  }

  .arm__centerline {
    stroke: var(--color-line-faint);
    stroke-width: 1;
    stroke-dasharray: 8 3 2 3;
  }

  .arm__gripper path {
    fill: none;
    stroke: var(--color-text);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .arm__palm {
    fill: var(--color-text);
  }

  .arm__joint {
    fill: var(--color-bg);
    stroke: var(--color-text);
    stroke-width: 1.25;
  }

  .arm__pin {
    fill: var(--color-text);
  }

  .arm__readout {
    display: block;
    margin-top: var(--space-1);
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { approachAngle, chooseElbow, solveIK, type Elbow, type Point, type Pose } from '../lib/ik';
  import {
    ARM,
    BOX_BOUNCE,
    BOX_FRICTION,
    BOX_G,
    BOX_HALF,
    BOX_REST,
    GROUND_Y,
    IDLE_WAYPOINTS,
    JAW_CLOSED,
    JAW_OPEN,
    REST_ELBOW,
    VIEW,
    armFrame,
    boxNearTip,
    constrainTarget,
    isInView,
    jawTransform,
    restPose,
    tipOf,
  } from '../lib/robot-arm';

  const IDLE_STEP_MS = 2800;
  const IDLE_PAUSE_MS = 8000;
  const GRASP_MS = 420;

  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');

  interface BoxState {
    x: number;
    y: number;
    vx: number;
    vy: number;
    held: boolean;
  }

  function mount(root: HTMLElement) {
    const svg = root.querySelector('svg')!;
    const link1 = root.querySelector<SVGGElement>('[data-link="1"]')!;
    const link2 = root.querySelector<SVGGElement>('[data-link="2"]')!;
    const link3 = root.querySelector<SVGGElement>('[data-link="3"]')!;
    const arc1 = root.querySelector<SVGPathElement>('[data-arc="1"]')!;
    const arc2 = root.querySelector<SVGPathElement>('[data-arc="2"]')!;
    const label1 = root.querySelector<SVGTextElement>('[data-label="1"]')!;
    const label2 = root.querySelector<SVGTextElement>('[data-label="2"]')!;
    const jawUpper = root.querySelector<SVGGElement>('[data-jaw="upper"]')!;
    const jawLower = root.querySelector<SVGGElement>('[data-jaw="lower"]')!;
    const crosshair = root.querySelector<SVGGElement>('[data-crosshair]')!;
    const boxEl = root.querySelector<SVGRectElement>('[data-box]')!;
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;

    let pose: Pose = restPose();
    let goal: Pose = { ...pose };
    let elbow: Elbow = REST_ELBOW;
    let jaw = JAW_OPEN;
    let jawGoal = JAW_OPEN;
    let frameId = 0;
    let lastTime = 0;
    let reaching = false;
    let dragPointer: number | null = null;
    let lastTouch = -Infinity;
    let idleIndex = 0;
    let idleTimer = 0;
    let inViewport = false;
    let graspUntil = 0;

    const box: BoxState = { x: BOX_REST.x, y: BOX_REST.y, vx: 0, vy: 0, held: false };

    const animated = () => !reducedMotion.matches;

    function renderBox() {
      boxEl.setAttribute('x', String(box.x - BOX_HALF));
      boxEl.setAttribute('y', String(box.y - BOX_HALF));
    }

    function render() {
      const f = armFrame(pose);
      link1.setAttribute('transform', f.link1);
      link2.setAttribute('transform', f.link2);
      link3.setAttribute('transform', f.link3);
      arc1.setAttribute('d', f.arc1);
      arc2.setAttribute('d', f.arc2);
      label1.setAttribute('x', String(f.label1.x));
      label1.setAttribute('y', String(f.label1.y));
      label2.setAttribute('x', String(f.label2.x));
      label2.setAttribute('y', String(f.label2.y));
      jawUpper.setAttribute('transform', jawTransform(jaw, -1));
      jawLower.setAttribute('transform', jawTransform(jaw, 1));
      readout.textContent = f.readout;
      if (box.held) {
        const tip = tipOf(pose);
        box.x = tip.x;
        box.y = tip.y;
      }
      renderBox();
    }

    function stepBox(dt: number) {
      if (box.held) {
        box.vx = 0;
        box.vy = 0;
        return true;
      }

      const floor = GROUND_Y - BOX_HALF;
      const moving = Math.abs(box.vx) > 0.5 || Math.abs(box.vy) > 0.5 || box.y < floor - 0.5;
      if (!moving) {
        box.vx = 0;
        box.vy = 0;
        box.y = floor;
        return false;
      }

      box.vy += BOX_G * dt;
      box.x += box.vx * dt;
      box.y += box.vy * dt;

      const minX = VIEW.x + BOX_HALF;
      const maxX = VIEW.x + VIEW.width - BOX_HALF;
      if (box.x < minX) {
        box.x = minX;
        box.vx = 0;
      } else if (box.x > maxX) {
        box.x = maxX;
        box.vx = 0;
      }

      if (box.y >= floor) {
        box.y = floor;
        if (Math.abs(box.vy) < 40) box.vy = 0;
        else box.vy *= -BOX_BOUNCE;
        box.vx *= Math.exp(-BOX_FRICTION * dt);
        if (Math.abs(box.vx) < 2) box.vx = 0;
      }

      return true;
    }

    function tick(time: number) {
      const dt = lastTime ? Math.min((time - lastTime) / 1000, 0.05) : 1 / 60;
      lastTime = time;

      pose = {
        theta1: approachAngle(pose.theta1, goal.theta1, dt, 9),
        theta2: pose.theta2 + (goal.theta2 - pose.theta2) * (1 - Math.exp(-9 * dt)),
        theta3: approachAngle(pose.theta3, goal.theta3, dt, 9),
      };
      jaw += (jawGoal - jaw) * (1 - Math.exp(-18 * dt));
      const boxMoving = stepBox(dt);
      render();

      const armSettled =
        Math.abs(goal.theta1 - pose.theta1) +
          Math.abs(goal.theta2 - pose.theta2) +
          Math.abs(goal.theta3 - pose.theta3) <
          1e-3 && Math.abs(jawGoal - jaw) < 0.02;

      if (armSettled && !boxMoving) {
        pose = { ...goal };
        jaw = jawGoal;
        render();
        frameId = 0;
        lastTime = 0;
      } else {
        frameId = requestAnimationFrame(tick);
      }
    }

    function update() {
      if (!animated()) {
        pose = { ...goal };
        jaw = jawGoal;
        if (box.held) {
          const tip = tipOf(pose);
          box.x = tip.x;
          box.y = tip.y;
        } else {
          box.y = Math.min(box.y, GROUND_Y - BOX_HALF);
          box.vy = 0;
          box.vx = 0;
        }
        render();
        return;
      }
      if (!frameId) frameId = requestAnimationFrame(tick);
    }

    function setTarget(raw: Point, showCrosshair = true) {
      const target = constrainTarget(raw);
      elbow = chooseElbow(target, ARM, elbow);
      goal = solveIK(target, ARM, elbow);
      if (showCrosshair && isInView(raw)) {
        crosshair.setAttribute('transform', `translate(${target.x} ${target.y})`);
        crosshair.setAttribute('visibility', 'visible');
      } else {
        crosshair.setAttribute('visibility', 'hidden');
      }
      update();
    }

    function tryPickOrPlace(at?: Point) {
      if (box.held) {
        box.held = false;
        box.vx = 0;
        box.vy = 0;
        update();
        return;
      }
      const tip = tipOf(pose);
      const near = boxNearTip(box, tip) || (at ? boxNearTip(box, at) : false);
      if (near) {
        box.held = true;
        box.vx = 0;
        box.vy = 0;
        update();
      }
    }

    function grasp(at?: Point) {
      jawGoal = JAW_CLOSED;
      graspUntil = performance.now() + GRASP_MS;
      tryPickOrPlace(at);
      update();
      window.setTimeout(() => {
        if (performance.now() >= graspUntil - 16) {
          jawGoal = JAW_OPEN;
          update();
        }
      }, GRASP_MS);
    }

    function toLocal(clientX: number, clientY: number): Point | null {
      const ctm = svg.getScreenCTM();
      if (!ctm) return null;
      const p = new DOMPoint(clientX, clientY).matrixTransform(ctm.inverse());
      return { x: p.x, y: p.y };
    }

    function centerOf(el: Element): Point | null {
      const r = el.getBoundingClientRect();
      return toLocal(r.left + r.width / 2, r.top + r.height / 2);
    }

    // Desktop: track the mouse anywhere on the page. Leaving the window keeps the last pose.
    window.addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType === 'touch' || reaching || !animated()) return;
        const p = toLocal(e.clientX, e.clientY);
        if (p) setTarget(p);
      },
      { passive: true },
    );

    // Reach for links on hover or keyboard focus.
    for (const el of document.querySelectorAll('[data-reach]')) {
      const reach = () => {
        if (!animated()) return;
        const p = centerOf(el);
        if (!p) return;
        reaching = true;
        setTarget(p, false);
      };
      const release = () => {
        reaching = false;
      };
      el.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType !== 'touch') reach();
      });
      el.addEventListener('pointerleave', release);
      el.addEventListener('focus', () => {
        if (el.matches(':focus-visible')) reach();
      });
      el.addEventListener('blur', () => {
        if (!reaching) return;
        release();
      });
    }

    // Click or tap: steer to that point and grasp (pick/place the box if near).
    svg.addEventListener('pointerdown', (e) => {
      const p = toLocal(e.clientX, e.clientY);
      if (!p) return;
      setTarget(p);
      grasp(p);
      if (e.pointerType === 'touch') {
        lastTouch = performance.now();
        dragPointer = e.pointerId;
        try {
          svg.setPointerCapture(e.pointerId);
        } catch {
          // Capture can fail if the pointer is already gone.
        }
      }
    });

    svg.addEventListener('pointermove', (e) => {
      if (e.pointerId !== dragPointer) return;
      lastTouch = performance.now();
      const p = toLocal(e.clientX, e.clientY);
      if (p) setTarget(p);
    });

    const endDrag = (e: PointerEvent) => {
      if (e.pointerId === dragPointer) dragPointer = null;
    };
    svg.addEventListener('pointerup', endDrag);
    svg.addEventListener('pointercancel', endDrag);

    function idleStep() {
      if (dragPointer !== null || performance.now() - lastTouch < IDLE_PAUSE_MS || box.held) return;
      idleIndex = (idleIndex + 1) % IDLE_WAYPOINTS.length;
      setTarget(IDLE_WAYPOINTS[idleIndex]);
    }

    function syncIdle() {
      const shouldIdle = inViewport && document.visibilityState === 'visible' && !finePointer.matches && animated();
      if (shouldIdle && !idleTimer) {
        idleTimer = window.setInterval(idleStep, IDLE_STEP_MS);
      } else if (!shouldIdle && idleTimer) {
        window.clearInterval(idleTimer);
        idleTimer = 0;
      }
    }

    new IntersectionObserver(([entry]) => {
      inViewport = entry.isIntersecting;
      syncIdle();
    }).observe(root);
    document.addEventListener('visibilitychange', syncIdle);
    finePointer.addEventListener('change', syncIdle);
    reducedMotion.addEventListener('change', syncIdle);

    root.setAttribute('data-ready', '');
  }

  document.querySelectorAll<HTMLElement>('[data-robot-arm]').forEach(mount);
</script>
