---
import { nav, site } from '../site.config';
import { withBase } from '../lib/url';

const current = Astro.url.pathname;
const isCurrent = (href: string) => {
  const target = withBase(href);
  return target !== withBase('/') && current.startsWith(target);
};
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href={withBase('/')} aria-label={`${site.name}, home`} data-reach>
      {site.name}
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__links">
        {
          nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                data-reach
                {...(item.newTab ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {item.label}
                {item.newTab && <span class="visually-hidden"> (opens in a new tab)</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-5) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: 1.3125rem;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-accent);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }

  .site-nav__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .site-nav__links a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .site-nav__links a:hover,
  .site-nav__links a[aria-current='page'] {
    color: var(--color-text);
  }

  .site-nav__links a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }
</style>
