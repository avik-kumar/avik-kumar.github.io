---
import Icon from './Icon.astro';
import { site } from '../site.config';

interface Props {
  /** `icons` renders compact icon-only links; `text` renders labelled links. */
  variant?: 'icons' | 'text';
  class?: string;
}

const { variant = 'text', class: className } = Astro.props;

const links = [
  { label: 'GitHub', href: site.github, icon: 'github' },
  { label: 'LinkedIn', href: site.linkedin, icon: 'linkedin' },
  { label: 'Email', href: `mailto:${site.email}`, icon: 'mail' },
] as const;
---

<ul class:list={['social', `social--${variant}`, className]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          aria-label={variant === 'icons' ? link.label : undefined}
          title={variant === 'icons' ? link.label : undefined}
          data-reach
          {...(link.href.startsWith('http') ? { rel: 'me noopener', target: '_blank' } : {})}
        >
          <Icon name={link.icon} size={variant === 'icons' ? 17 : 15} />
          {variant === 'text' && <span>{link.label}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .social a:hover {
    color: var(--color-accent);
  }

  .social--icons {
    gap: var(--space-1);
  }

  .social--icons a {
    padding: var(--space-2);
  }

  .social--text {
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
  }
</style>
